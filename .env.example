# FalkorDB (local docker compose defaults; FalkorDB Cloud free tier uses host/port/user/pass without TLS)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Graph name prefix; one graph per tenant, e.g. bt:demo
BACKTRACK_TENANT=demo

# LLM via OpenRouter (free models). Replay mode works without a key.
OPENROUTER_API_KEY=
BACKTRACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
BACKTRACK_MODEL_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Daily cap on live LLM runs (free tier is 50 requests/day; one run is ~7 requests)
BACKTRACK_LLM_DAILY_LIMIT=40

# Web
RESET_TOKEN=change-me
NEXT_PUBLIC_MOCK=0
