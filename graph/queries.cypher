// GENERATED by `pnpm gen:queries` from packages/core/src/graph/queries.ts. Do not edit.
// Every value is a $parameter. The only literal is the variable-length bound, clamped to
// 1..10 in code (FalkorDB rejects a parameter there); it is shown here at the default, 5.

// ==============================================================================================
// The query catalogue (docs/PLAN.md §5)
// ==============================================================================================

// Q1 · Downstream closure with paths (read, depth-bounded)
// answers: if I undo this action, which later actions depend on it (transitively, up to depth N), how many hops away, and through which actions?
MATCH p = (root:Action {id: $actionId})<-[:DEPENDS_ON*1..5]-(d:Action)
WHERE d.kind = 'do' AND all(n IN tail(nodes(p)) WHERE n.status = 'done') AND (d)-[:CAUSED]->(:Effect)
WITH d, p ORDER BY length(p)
WITH d, head(collect(p)) AS p
MATCH (ag:Agent)-[:RAN]->(run:Run)-[:HAS]->(:Step)-[:DID]->(d)
RETURN d.id AS id, d.tool AS tool, d.seq AS seq, ag.id AS agentId, run.id AS runId,
  d.reversible AS reversible, d.inverse_tool AS inverseTool, d.mitigation_tool AS mitigationTool,
  length(p) AS hops, [n IN nodes(p) | n.tool] AS via, [n IN nodes(p) | n.id] AS viaIds
ORDER BY seq DESC;

// Q2 · Undo plan order (read)
// answers: in what order can these actions be undone, and what did each one change? (seq DESC is a reverse topological order because DEPENDS_ON always points to a smaller seq)
MATCH (a:Action)
WHERE a.id IN $actionIds
OPTIONAL MATCH (a)-[:CAUSED]->(f:Effect)-[:ON]->(e:Entity)
WITH a, f, e ORDER BY f.id
WITH a, [x IN collect({type: e.type, key: e.key, display: e.display, kind: f.kind}) WHERE x.key IS NOT NULL] AS entities
RETURN a.id AS id, a.tool AS tool, a.seq AS seq, a.status AS status, a.reversible AS reversible,
  a.inverse_tool AS inverseTool, a.mitigation_tool AS mitigationTool, entities
ORDER BY seq DESC;

// Q3 · Blast radius summary (read, depth-bounded)
// answers: how big is undoing this action: how many actions, how many of them irreversible, which entities?
MATCH (root:Action {id: $actionId})
OPTIONAL MATCH p = (root)<-[:DEPENDS_ON*1..5]-(d:Action)
WHERE d.kind = 'do' AND all(n IN tail(nodes(p)) WHERE n.status = 'done') AND (d)-[:CAUSED]->(:Effect)
WITH root, collect(DISTINCT d) AS dependents
UNWIND [root] + dependents AS a
OPTIONAL MATCH (a)-[:CAUSED]->(:Effect)-[:ON]->(e:Entity)
RETURN count(DISTINCT a) AS actions,
  count(DISTINCT CASE WHEN a.reversible = false THEN a.id END) AS irreversible,
  collect(DISTINCT e.type + ':' + e.key) AS entities;

// Q4 · Gate: what an irreversible action would lock in (read, depth-bounded)
// answers: which reversible changes does this pending irreversible action build on, so that doing it would make them impossible to undo cleanly?
MATCH (pending:Action {id: $actionId})-[:DEPENDS_ON*1..10]->(u:Action)
WHERE u.status = 'done' AND u.kind = 'do' AND u.reversible = true AND (u)-[:CAUSED]->(:Effect)
RETURN DISTINCT u.id AS id, u.tool AS tool, u.seq AS seq
ORDER BY seq;

// Q5 · Policy check (read)
// answers: does any policy block, require confirmation for, or warn about this call: this tool, or any tool on these entities, for this agent?
MATCH (pol:Policy)
WHERE (pol.tool = $tool OR (pol.tool IS NULL AND (pol)-[:APPLIES_TO]->(:Entity)))
  AND (NOT (pol)-[:ON_TOOL]->(:Agent) OR (pol)-[:ON_TOOL]->(:Agent {id: $agentId}))
OPTIONAL MATCH (pol)-[:APPLIES_TO]->(e:Entity)
WITH pol, collect(e.type + ':' + e.key) AS scope
WHERE size(scope) = 0 OR any(k IN scope WHERE k IN $entities)
RETURN pol.id AS id, pol.rule AS rule, pol.kind AS kind, pol.ts AS ts, scope,
  CASE pol.kind WHEN 'block' THEN 0 WHEN 'confirm' THEN 1 ELSE 2 END AS rank
ORDER BY rank, ts;

// Q6 · Explain an action (read)
// answers: why did this action happen, what did it read and who wrote that, what did it change, and what depends on it?
MATCH (ag:Agent)-[:RAN]->(r:Run)-[:HAS]->(s:Step)-[:DID]->(a:Action {id: $actionId})
OPTIONAL MATCH (a)-[:READ]->(re:Entity)
OPTIONAL MATCH (re)<-[:ON]-(rf:Effect)<-[:CAUSED]-(w:Action)
WHERE w.seq < a.seq
WITH ag, r, s, a, re, rf, w ORDER BY w.seq DESC
WITH ag, r, s, a, re, head(collect({id: w.id, tool: w.tool, seq: w.seq, field: rf.field, after: rf.after})) AS wr
WITH ag, r, s, a, [x IN collect({entity: re.type + ':' + re.key, writerId: wr.id, writerTool: wr.tool,
  writerSeq: wr.seq, field: wr.field, after: wr.after}) WHERE x.entity IS NOT NULL] AS reads
OPTIONAL MATCH (a)-[:CAUSED]->(f:Effect)-[:ON]->(e:Entity)
WITH ag, r, s, a, reads, f, e ORDER BY f.id
WITH ag, r, s, a, reads, [x IN collect({id: f.id, kind: f.kind, field: f.field, before: f.before,
  after: f.after, ts: f.ts, type: e.type, key: e.key, display: e.display}) WHERE x.id IS NOT NULL] AS effects
OPTIONAL MATCH (a)-[:DEPENDS_ON]->(up:Action)
WITH ag, r, s, a, reads, effects,
  [u IN collect(DISTINCT up) | {actionId: u.id, tool: u.tool, seq: u.seq}] AS dependsOn
OPTIONAL MATCH (down:Action)-[:DEPENDS_ON]->(a)
WITH ag, r, s, a, reads, effects, dependsOn,
  [x IN collect(DISTINCT down) | {actionId: x.id, tool: x.tool, seq: x.seq}] AS dependedOnBy
RETURN a.id AS id, a.seq AS seq, a.tool AS tool, a.args AS args, a.result AS result, a.ts AS ts,
  a.kind AS kind, a.status AS status, a.reversible AS reversible, a.inverse_tool AS inverseTool,
  a.mitigation_tool AS mitigationTool, r.id AS runId, s.id AS stepId, ag.id AS agentId,
  s.thought AS thought, reads, effects, dependsOn, dependedOnBy;

// Q7 · Cross-agent dependents (read, depth-bounded)
// answers: which other agents' actions depend on this one (through Step, Run and Agent), and how far away are they?
MATCH (rag:Agent)-[:RAN]->(:Run)-[:HAS]->(:Step)-[:DID]->(root:Action {id: $actionId})
MATCH p = (root)<-[:DEPENDS_ON*1..5]-(d:Action)
WHERE d.kind = 'do' AND all(n IN tail(nodes(p)) WHERE n.status = 'done') AND (d)-[:CAUSED]->(:Effect)
MATCH (ag:Agent)-[:RAN]->(:Run)-[:HAS]->(:Step)-[:DID]->(d)
WHERE ag.id <> rag.id
RETURN ag.id AS agentId, d.id AS actionId, d.tool AS tool, min(length(p)) AS hops
ORDER BY hops, actionId;

// Q8 · Load-bearing actions (PageRank) (read)
// answers: which actions does the most other work rest on? (PageRank over DEPENDS_ON: rank flows from dependents to what they depend on)
CALL algo.pageRank('Action', 'DEPENDS_ON') YIELD node, score
WITH node, score WHERE node.kind = 'do'
OPTIONAL MATCH (ag:Agent)-[:RAN]->(:Run)-[:HAS]->(:Step)-[:DID]->(node)
RETURN node.id AS id, node.tool AS tool, node.seq AS seq, node.status AS status, ag.id AS agentId, score
ORDER BY score DESC, seq
LIMIT $limit;

// Q9 · Hinge actions (betweenness) (read)
// answers: which actions sit on the most dependency paths between other actions, so that undoing them splits the history?
CALL algo.betweenness({nodeLabels: ['Action'], relationshipTypes: ['DEPENDS_ON']}) YIELD node, score
WITH node, score WHERE node.kind = 'do'
OPTIONAL MATCH (ag:Agent)-[:RAN]->(:Run)-[:HAS]->(:Step)-[:DID]->(node)
RETURN node.id AS id, node.tool AS tool, node.seq AS seq, node.status AS status, ag.id AS agentId, score
ORDER BY score DESC, seq
LIMIT $limit;

// Q10 · Independent clusters (weakly connected components) (read)
// answers: which groups of actions are independent of each other, so that undoing one group cannot touch another?
CALL algo.wcc({nodeLabels: ['Action'], relationshipTypes: ['DEPENDS_ON']}) YIELD node, componentId
WITH componentId, node ORDER BY node.seq
WITH componentId, collect({id: node.id, tool: node.tool, seq: node.seq}) AS actions
RETURN componentId, size(actions) AS size, actions
ORDER BY size DESC, componentId;

// Q11 · Dependency path between two actions (SPpaths) (read)
// answers: how does a later action depend on an earlier one: the shortest DEPENDS_ON route from the earlier action to the later?
MATCH (s:Action {id: $from}), (t:Action {id: $to})
CALL algo.SPpaths({sourceNode: s, targetNode: t, relTypes: ['DEPENDS_ON'], weightProp: 'weight',
  relDirection: 'incoming', pathCount: 1, maxLen: 10})
YIELD path, pathWeight
RETURN [n IN nodes(path) | n.id] AS ids, [n IN nodes(path) | n.tool] AS tools, pathWeight;

// Q12 · Entity history across runs and agents (read)
// answers: who changed this entity, when, in which run, from what to what?
MATCH (e:Entity {type: $type, key: $key})<-[:ON]-(f:Effect)<-[:CAUSED]-(a:Action)
MATCH (ag:Agent)-[:RAN]->(r:Run)-[:HAS]->(:Step)-[:DID]->(a)
RETURN a.seq AS seq, a.id AS actionId, a.tool AS tool, a.kind AS kind, a.status AS status,
  f.field AS field, f.before AS before, f.after AS after, f.ts AS ts, r.id AS runId, ag.id AS agentId
ORDER BY seq, actionId;

// Q13 · Recall (read)
// answers: have we undone this action, this tool, or changes to this entity before, and is there a policy about it? (with dates)
MATCH (plan:UndoPlan)-[:ROOT]->(root:Action)
WHERE root.id = $actionId OR root.tool = $tool
   OR (plan)-[:REVERTS|COULD_NOT_REVERT]->(:Action {id: $actionId})
   OR (root)-[:CAUSED]->(:Effect)-[:ON]->(:Entity {type: $type, key: $key})
RETURN 'plan' AS kind, plan.id AS id, plan.ts AS ts, plan.status AS status, plan.summary AS summary,
  root.id AS actionId, root.tool AS tool
UNION
MATCH (pol:Policy)
WHERE pol.tool = $tool OR (pol)-[:APPLIES_TO]->(:Entity {type: $type, key: $key})
RETURN 'policy' AS kind, pol.id AS id, pol.ts AS ts, pol.kind AS status, pol.rule AS summary,
  null AS actionId, pol.tool AS tool;

// Q14 · Conflict check (read)
// answers: is each entity this action changed still exactly as the action left it (Entity.state vs Effect.after), and if not, which later live action wrote it?
MATCH (a:Action {id: $actionId})-[:CAUSED]->(f:Effect)-[:ON]->(e:Entity)
OPTIONAL MATCH (e)<-[:ON]-(:Effect)<-[:CAUSED]-(later:Action)
WHERE later.seq > a.seq AND later.status = 'done'
WITH f, e, [w IN collect(DISTINCT later) | {id: w.id, tool: w.tool, seq: w.seq}] AS laterWriters
RETURN f.id AS effectId, f.kind AS kind, f.field AS field, f.before AS before, f.after AS after,
  e.type AS type, e.key AS key, e.display AS display, e.state AS state, laterWriters
ORDER BY effectId;

// Q15 · Rehearsal diff: entity states a plan touches (read)
// answers: what state is every entity this plan touches in, in this graph? Run on the live graph and on the GRAPH.COPY fork after the rehearsal; the difference is the diff.
MATCH (:UndoPlan {id: $planId})-[:REVERTS|COULD_NOT_REVERT]->(a:Action)
OPTIONAL MATCH (a)-[:CAUSED]->(:Effect)-[:ON]->(e1:Entity)
OPTIONAL MATCH (a)<-[:UNDOES]-(:Action)-[:CAUSED]->(:Effect)-[:ON]->(e2:Entity)
WITH collect(DISTINCT e1) + collect(DISTINCT e2) AS touched
UNWIND touched AS e
RETURN DISTINCT e.type AS type, e.key AS key, e.state AS state
ORDER BY type, key;

// ==============================================================================================
// Schema and meta
// ==============================================================================================

// S1 · Bootstrap marker (read)
// answers: has this tenant graph already been given its schema?
OPTIONAL MATCH (m:Meta {id: 'meta'}) RETURN m.bootstrapped AS done;

// S2 · Sequence counter (write)
// answers: creates the single counter that gives every action its global seq (once)
MERGE (c:Counter {id: 'seq'}) ON CREATE SET c.n = 0;

// S3 · Agent node (write)
// answers: registers an agent so its runs and actions can be attributed
MERGE (a:Agent {id: $id}) SET a.name = $name, a.version = $version;

// S4 · User node (write)
// answers: registers the human who approves, requests undos and sets policies
MERGE (u:User {id: $id}) SET u.name = $name;

// S5 · Bootstrap complete (write)
// answers: marks the schema as done so later calls are a no-op
MERGE (m:Meta {id: 'meta'})
ON CREATE SET m.llm_calls_day = '', m.llm_calls_count = 0
SET m.bootstrapped = true;

// S6 · Seed timestamp (write)
// answers: records when the synthetic world was last seeded
MATCH (m:Meta {id: 'meta'}) SET m.seeded_at = $ts;

// S7 · Tenant status (read)
// answers: is this tenant ready, when was it seeded, and how many actions has it recorded?
OPTIONAL MATCH (m:Meta {id: 'meta'})
OPTIONAL MATCH (c:Counter {id: 'seq'})
RETURN m.bootstrapped AS bootstrapped, m.seeded_at AS seededAt, c.n AS seq;

// S8 · Agents (read)
// answers: which agents are registered in this tenant (policies and runs may only name these)?
MATCH (a:Agent) RETURN a.id AS id, a.name AS name ORDER BY id;

// S9 · Claim one LLM call from the daily budget (write)
// answers: may we make one more model request today? (counts it if so; one statement, so concurrent runs cannot overspend)
MERGE (m:Meta {id: 'meta'})
WITH m, CASE WHEN m.llm_calls_day = $day THEN coalesce(m.llm_calls_count, 0) ELSE 0 END AS used
WITH m, used, used < $limit AS ok
SET m.llm_calls_day = $day, m.llm_calls_count = CASE WHEN ok THEN used + 1 ELSE used END
RETURN ok, CASE WHEN ok THEN used + 1 ELSE used END AS used;

// S10 · LLM calls used today (read)
// answers: how many model requests has the live mode made today?
OPTIONAL MATCH (m:Meta {id: 'meta'})
RETURN CASE WHEN m.llm_calls_day = $day THEN coalesce(m.llm_calls_count, 0) ELSE 0 END AS used;

// ==============================================================================================
// World (Entity.state)
// ==============================================================================================

// W1 · Seed entities (write)
// answers: writes the synthetic world (customers, orders) as Entity nodes with JSON state
UNWIND range(0, size($keys) - 1) AS i
MERGE (e:Entity {type: $types[i], key: $keys[i]})
SET e.display = $displays[i], e.state = $states[i]
RETURN count(e) AS n;

// W2 · Entities by key (read)
// answers: what is the current state of these entities?
UNWIND range(0, size($keys) - 1) AS i
MATCH (e:Entity {type: $types[i], key: $keys[i]})
RETURN e.type AS type, e.key AS key, e.display AS display, e.state AS state;

// W3 · World listing (read)
// answers: what does the world look like right now (optionally one entity type)?
MATCH (e:Entity)
WHERE $type IS NULL OR e.type = $type
RETURN e.type AS type, e.key AS key, e.display AS display, e.state AS state
ORDER BY type, key;

// W4 · Effects after a point in time (read)
// answers: which changes happened after seq N, newest first (the time scrubber rolls these back)?
MATCH (a:Action)-[:CAUSED]->(f:Effect)-[:ON]->(e:Entity)
WHERE a.seq > $seq
RETURN a.seq AS seq, f.id AS effectId, f.field AS field, f.before AS before, e.type AS type, e.key AS key
ORDER BY seq DESC, effectId DESC;

// W5 · Entity count by type (read)
// answers: how many entities of this type have ever existed (for the next readable key)?
MATCH (e:Entity {type: $type}) RETURN count(e) AS n;

// ==============================================================================================
// Recording runs, steps and actions
// ==============================================================================================

// R1 · Start a run (write)
// answers: records that an agent (or Backtrack itself, for an undo) started a run with a goal
MATCH (ag:Agent {id: $agentId})
CREATE (ag)-[:RAN]->(r:Run {id: $runId, kind: $kind, agent_id: $agentId, status: 'running',
  goal: $goal, model: $model, started_at: $ts, messages: '[]'})
RETURN r.id AS id;

// R2 · Start a step (write)
// answers: records one reasoning step of a run and chains it after the previous step
MATCH (r:Run {id: $runId})
CREATE (r)-[:HAS]->(s:Step {id: $stepId, index: $index, thought: $thought, ts: $ts})
WITH r, s
OPTIONAL MATCH (r)-[:HAS]->(prev:Step)
WHERE prev.index = $index - 1
FOREACH (x IN CASE WHEN prev IS NULL THEN [] ELSE [prev] END | CREATE (x)-[:NEXT]->(s))
RETURN s.id AS id;

// R3 · Record an action (one statement) (write)
// answers: records a tool call with its seq, what it read, what it changed (and the new entity state), and links it to the latest earlier writer of every entity it touched
MATCH (c:Counter {id: 'seq'})
SET c.n = c.n + 1
WITH c.n AS seq
MATCH (s:Step {id: $stepId})
CREATE (s)-[:DID]->(a:Action {id: $actionId, seq: seq, tool: $tool, args: $args, result: $result,
  ts: $ts, kind: $kind, status: $status, reversible: $reversible,
  inverse_tool: $inverseTool, mitigation_tool: $mitigationTool})
WITH a, seq
FOREACH (i IN range(0, size($readKeys) - 1) |
  MERGE (e:Entity {type: $readTypes[i], key: $readKeys[i]})
  ON CREATE SET e.display = $readDisplays[i]
  MERGE (a)-[:READ]->(e))
FOREACH (i IN range(0, size($effIds) - 1) |
  MERGE (e:Entity {type: $effTypes[i], key: $effKeys[i]})
  ON CREATE SET e.display = $effDisplays[i]
  SET e.state = $effStates[i]
  CREATE (a)-[:CAUSED]->(:Effect {id: $effIds[i], kind: $effKinds[i], field: $effFields[i],
    before: $effBefore[i], after: $effAfter[i], ts: $ts})-[:ON]->(e))
WITH a, seq
OPTIONAL MATCH (x:Action {id: $undoes})
FOREACH (n IN CASE WHEN x IS NULL THEN [] ELSE [x] END |
  CREATE (a)-[:UNDOES]->(n)
  SET n.status = CASE WHEN $kind = 'undo' THEN 'undone' ELSE n.status END)
WITH a, seq
UNWIND range(0, size($depKeys)) AS i
OPTIONAL MATCH (e:Entity {type: $depTypes[i], key: $depKeys[i]})<-[:ON]-(:Effect)<-[:CAUSED]-(w:Action)
WHERE w.seq < seq AND w.status = 'done'
WITH a, seq, i, w ORDER BY w.seq DESC
WITH a, seq, i, head(collect(w)) AS latest
WITH a, seq, latest, collect($depVia[i]) AS vias
FOREACH (w IN CASE WHEN latest IS NULL THEN [] ELSE [latest] END |
  MERGE (a)-[d:DEPENDS_ON]->(w)
  SET d.weight = 1, d.via = CASE WHEN 'read' IN vias THEN 'read' ELSE 'write' END)
WITH seq, collect(latest.id) AS dependsOn
RETURN seq, dependsOn;

// R4 · Commit an approved action (write)
// answers: applies the changes of a pending (gated) action once a human approved it
MATCH (a:Action {id: $actionId})
WHERE a.status = 'pending'
SET a.status = 'done', a.result = $result
FOREACH (i IN range(0, size($effIds) - 1) |
  MERGE (e:Entity {type: $effTypes[i], key: $effKeys[i]})
  ON CREATE SET e.display = $effDisplays[i]
  SET e.state = $effStates[i]
  CREATE (a)-[:CAUSED]->(:Effect {id: $effIds[i], kind: $effKinds[i], field: $effFields[i],
    before: $effBefore[i], after: $effAfter[i], ts: $ts})-[:ON]->(e))
RETURN a.seq AS seq;

// R5 · Run status (write)
// answers: marks a run running, paused on an approval, or finished
MATCH (r:Run {id: $runId})
SET r.status = $status, r.pending_action_id = $pendingActionId,
    r.ended_at = CASE WHEN $status IN ['done', 'failed', 'undone'] THEN $ts ELSE r.ended_at END
RETURN r.id AS id;

// R6 · Run transcript (write)
// answers: stores the LLM conversation of a run so a later run can read it
MATCH (r:Run {id: $runId}) SET r.messages = $messages RETURN r.id AS id;

// R7 · Human decision on a gated action (write)
// answers: records who approved or denied a pending action, when and why
MATCH (u:User {id: $userId}), (a:Action {id: $actionId})
WHERE a.status = 'pending' AND NOT (a)<-[:APPROVED]-(:User) AND NOT (a)<-[:DENIED]-(:User)
FOREACH (_ IN CASE WHEN $approved THEN [1] ELSE [] END |
  CREATE (u)-[:APPROVED {ts: $ts, reason: $reason}]->(a))
FOREACH (_ IN CASE WHEN $approved THEN [] ELSE [1] END |
  CREATE (u)-[:DENIED {ts: $ts, reason: $reason}]->(a)
  SET a.status = 'denied')
RETURN a.status AS status;

// R8 · Approval state (read)
// answers: has a human approved or denied this pending action yet?
MATCH (a:Action {id: $actionId})
OPTIONAL MATCH (u:User)-[r:APPROVED|DENIED]->(a)
RETURN a.status AS status, type(r) AS decision, u.id AS by;

// R9 · Runs in progress (read)
// answers: is an agent run or an undo still in progress on this tenant (started recently and not finished)?
MATCH (r:Run)
WHERE r.status IN ['running', 'paused'] AND r.started_at >= $since
RETURN r.id AS id, r.kind AS kind, r.agent_id AS agentId, r.status AS status,
  r.started_at AS startedAt
ORDER BY startedAt;

// ==============================================================================================
// Undo plans and policies
// ==============================================================================================

// P1 · Persist an undo plan (write)
// answers: records who asked to undo what, and the ordered steps (REVERTS, or COULD_NOT_REVERT with a mitigation)
MATCH (u:User {id: $userId}), (root:Action {id: $rootId})
CREATE (u)-[:REQUESTED {ts: $ts}]->(p:UndoPlan {id: $planId, root_action_id: $rootId, ts: $ts,
  status: 'proposed', summary: $summary, depth: $depth})-[:ROOT]->(root)
WITH p
UNWIND range(0, size($stepIds) - 1) AS i
MATCH (a:Action {id: $stepIds[i]})
FOREACH (_ IN CASE WHEN $stepModes[i] = 'mitigation' THEN [1] ELSE [] END |
  CREATE (p)-[:COULD_NOT_REVERT {order: i + 1, mode: $stepModes[i], label: $stepLabels[i],
    hops: $stepHops[i], via: $stepVia[i], entity: $stepEntities[i],
    mitigation: $stepMitigations[i]}]->(a))
FOREACH (_ IN CASE WHEN $stepModes[i] = 'mitigation' THEN [] ELSE [1] END |
  CREATE (p)-[:REVERTS {order: i + 1, mode: $stepModes[i], label: $stepLabels[i],
    hops: $stepHops[i], via: $stepVia[i], entity: $stepEntities[i]}]->(a))
RETURN count(a) AS steps;

// P2 · Load an undo plan (read)
// answers: what does this undo plan contain, in order, and what state is it in?
MATCH (p:UndoPlan {id: $planId})-[:ROOT]->(root:Action)
MATCH (p)-[r:REVERTS|COULD_NOT_REVERT]->(a:Action)
MATCH (ag:Agent)-[:RAN]->(:Run)-[:HAS]->(:Step)-[:DID]->(a)
WITH p, root, r, a, ag
ORDER BY r.order
RETURN p.id AS id, root.id AS rootId, p.ts AS ts, p.status AS status, p.summary AS summary,
  p.depth AS depth,
  collect({actionId: a.id, tool: a.tool, seq: a.seq, status: a.status, agentId: ag.id,
    order: r.order, mode: r.mode, label: r.label, hops: r.hops, via: r.via, entity: r.entity}) AS steps;

// P3 · Plan status (write)
// answers: marks a plan rehearsed, executing, executed, partial or conflict
MATCH (p:UndoPlan {id: $planId}) SET p.status = $status RETURN p.id AS id;

// P4 · Record a conflict (write)
// answers: records that a plan step could not be applied because the world changed since
MATCH (p:UndoPlan {id: $planId}), (a:Action {id: $actionId})
CREATE (p)-[:CONFLICT {reason: $reason}]->(a)
RETURN a.id AS id;

// P5 · Set a policy (write)
// answers: records a "never again" rule, who set it, which agent and entity it applies to, and which plan prompted it
MATCH (u:User {id: $userId})
CREATE (u)-[:SET {ts: $ts}]->(pol:Policy {id: $policyId, rule: $rule, kind: $kind, tool: $tool,
  created_from_plan_id: $createdFromPlanId, ts: $ts})
WITH pol
OPTIONAL MATCH (ag:Agent {id: $agentId})
FOREACH (x IN CASE WHEN ag IS NULL THEN [] ELSE [ag] END | CREATE (pol)-[:ON_TOOL]->(x))
WITH pol
OPTIONAL MATCH (e:Entity {type: $entityType, key: $entityKey})
FOREACH (x IN CASE WHEN e IS NULL THEN [] ELSE [e] END | CREATE (pol)-[:APPLIES_TO]->(x))
RETURN pol.id AS id;

// P6 · Record a blocked action (write)
// answers: records which policy stopped which action
MATCH (pol:Policy {id: $policyId}), (a:Action {id: $actionId})
CREATE (pol)-[:BLOCKED {ts: $ts}]->(a)
RETURN a.id AS id;

// P7 · Already compensated? (read)
// answers: has an undo or mitigation action already been recorded for this original (UNDOES)?
MATCH (:Action)-[u:UNDOES]->(:Action {id: $actionId})
WHERE ID(u) >= 0
RETURN count(u) AS n;

// ==============================================================================================
// Views for the UI and the agents
// ==============================================================================================

// V1 · Action list (read)
// answers: which actions have been recorded, in order, by which agent?
MATCH (ag:Agent)-[:RAN]->(r:Run)-[:HAS]->(s:Step)-[:DID]->(a:Action)
RETURN a.id AS id, a.seq AS seq, a.tool AS tool, a.args AS args, a.result AS result,
  a.ts AS ts, a.kind AS kind, a.status AS status, a.reversible AS reversible,
  a.inverse_tool AS inverseTool, a.mitigation_tool AS mitigationTool,
  r.id AS runId, s.id AS stepId, ag.id AS agentId
ORDER BY seq;

// V2 · Actions by id (read)
// answers: what exactly are these recorded actions?
MATCH (ag:Agent)-[:RAN]->(r:Run)-[:HAS]->(s:Step)-[:DID]->(a:Action)
WHERE a.id IN $ids
RETURN a.id AS id, a.seq AS seq, a.tool AS tool, a.args AS args, a.result AS result,
  a.ts AS ts, a.kind AS kind, a.status AS status, a.reversible AS reversible,
  a.inverse_tool AS inverseTool, a.mitigation_tool AS mitigationTool,
  r.id AS runId, s.id AS stepId, ag.id AS agentId
ORDER BY seq;

// V3 · Graph snapshot: nodes (read)
// answers: which actions, touched entities, agents, runs, plans, policies and users should the graph view draw?
MATCH (n)
WHERE (n:Action OR n:Agent OR n:Run OR n:UndoPlan OR n:Policy OR n:User)
   OR (n:Entity AND ((n)<-[:READ]-() OR (n)<-[:ON]-()))
WITH n, labels(n)[0] AS label
OPTIONAL MATCH (ag:Agent)-[:RAN]->(r:Run)-[:HAS]->(:Step)-[:DID]->(n)
RETURN CASE WHEN label = 'Entity' THEN n.type + ':' + n.key ELSE n.id END AS id, label,
  {tool: n.tool, status: n.status, kind: n.kind, seq: n.seq, reversible: n.reversible,
   name: n.name, display: n.display, rule: n.rule, goal: n.goal, summary: n.summary,
   agentId: coalesce(ag.id, n.agent_id), runId: r.id} AS props;

// V4 · Graph snapshot: links (read)
// answers: how are those nodes connected (Steps and Effects collapsed so an action links straight to its run and entities)?
MATCH (a:Action)-[:CAUSED]->(:Effect)-[:ON]->(e:Entity)
RETURN DISTINCT a.id AS source, e.type + ':' + e.key AS target, 'CAUSED' AS type, null AS order
UNION
MATCH (a:Action)-[:READ]->(e:Entity)
RETURN a.id AS source, e.type + ':' + e.key AS target, 'READ' AS type, null AS order
UNION
MATCH (r:Run)-[:HAS]->(:Step)-[:DID]->(a:Action)
RETURN r.id AS source, a.id AS target, 'DID' AS type, null AS order
UNION
MATCH (x)-[rel:DEPENDS_ON|UNDOES|RAN|ROOT|REVERTS|COULD_NOT_REVERT|CONFLICT|APPROVED|DENIED|REQUESTED|SET|ON_TOOL|BLOCKED]->(y)
WHERE NOT x:Entity AND NOT y:Entity
RETURN x.id AS source, y.id AS target, type(rel) AS type, rel.order AS order
UNION
MATCH (pol:Policy)-[:APPLIES_TO]->(e:Entity)
RETURN pol.id AS source, e.type + ':' + e.key AS target, 'APPLIES_TO' AS type, null AS order;
